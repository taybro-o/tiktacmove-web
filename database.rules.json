{
  "rules": {
    "queue": {
      ".read": true,
      "$peerId": {
        ".write": true,
        ".validate": "newData.hasChildren(['peerId', 'name', 'timestamp']) && newData.child('peerId').isString() && newData.child('name').isString() && newData.child('name').val().length <= 30"
      }
    },
    "rooms": {
      ".read": true,
      "$roomCode": {
        ".write": true,
        ".validate": "newData.hasChildren(['hostName', 'timestamp']) && newData.child('hostName').isString() && newData.child('hostName').val().length <= 30"
      }
    },
    "games": {
      "$gameId": {
        ".read": true,
        ".write": true,
        "chat": {
          ".validate": "!newData.exists() || (newData.hasChildren(['sender', 'text']) && newData.child('sender').isString() && newData.child('sender').val().length <= 30 && newData.child('text').isString() && newData.child('text').val().length <= 200)"
        },
        "state": {
          ".validate": "!newData.exists() || (newData.hasChildren(['board', 'moveCount']) && newData.child('moveCount').isNumber())"
        }
      }
    },
    "leaderboard": {
      ".read": true,
      "$season": {
        "$user": {
          ".write": true,
          ".validate": "newData.hasChildren(['username', 'wins', 'losses']) && newData.child('username').isString() && newData.child('username').val().length <= 30 && newData.child('wins').isNumber() && newData.child('losses').isNumber() && (!data.exists() || (newData.child('wins').val() >= data.child('wins').val() && newData.child('losses').val() >= data.child('losses').val()))"
        }
      }
    }
  }
}
