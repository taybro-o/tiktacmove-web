{
  "rules": {
    "queue": {
      ".read": true,
      "$peerId": {
        ".write": true,
        ".validate": "!newData.exists() || (newData.hasChildren(['peerId', 'name']) && newData.child('peerId').isString())"
      }
    },
    "rooms": {
      ".read": true,
      "$roomCode": {
        ".write": true,
        ".validate": "!newData.exists() || newData.hasChildren(['hostName'])"
      }
    },
    "games": {
      "$gameId": {
        ".read": true,
        ".write": true,
        "chat": {
          ".validate": "!newData.exists() || (newData.hasChildren(['sender', 'text']) && newData.child('sender').isString() && newData.child('text').isString() && newData.child('text').val().length <= 200)"
        },
        "state": {
          ".validate": "!newData.exists() || newData.hasChildren(['board', 'moveCount'])"
        }
      }
    },
    "leaderboard": {
      ".read": true,
      "$season": {
        ".read": true,
        "$user": {
          ".write": true,
          ".validate": "!newData.exists() || (newData.hasChildren(['username', 'wins', 'losses']) && newData.child('username').isString() && newData.child('wins').isNumber() && newData.child('losses').isNumber())"
        }
      }
    }
  }
}
